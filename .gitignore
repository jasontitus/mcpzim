# Vendored binary framework — 207 MB, too big for git.
# Download from https://github.com/kiwix/kiwix-build/releases
# (CoreKiwix.xcframework, currently version 14.2.0) and unzip into
# ios/MCPZimChat/Frameworks/ before building.
ios/MCPZimChat/Frameworks/CoreKiwix.xcframework/
tools/gemma-smoke/.build/
dropped-request.log

# Fine-tune training data + run logs + fused model outputs (large, regenerable)
tools/fine-tune/*.jsonl
tools/fine-tune/logs/
tools/fine-tune/ft-out-*/
*.gguf

# logpipe: raw device logs + built corpus contain user queries/GPS — keep local
eval/corpus/raw/
eval/corpus/*.jsonl

# Firebase client config — contains the project API key; keep out of
# source control (GitHub secret scanning flagged it 2026-08-03). The
# build reads these from the working tree; get them from the Firebase
# console or the shared vault.
ios/MCPZimChat/GoogleService-Info.plist
ios/MCPZimChat/GoogleService-Info-Mac.plist
